<mxfile host="app.diagrams.net" type="device">
  <diagram id="utcp-architecture" name="UTCP Architecture">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="zone" value="Azure workload boundary - LangGraph runtime uses private connectivity to Azure OpenAI, Blob Storage, and SQL MI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="230" y="55" width="1140" height="700" as="geometry"/></mxCell>
        <mxCell id="title" value="UTCP implementation - multi-agent file and SQL workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#12304a;" vertex="1" parent="1"><mxGeometry x="25" y="20" width="900" height="35" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Example deployment: Python API and LangGraph in a VNet-integrated app runtime; private endpoints/network paths are configured for Azure services." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="25" y="55" width="1150" height="25" as="geometry"/></mxCell>

        <mxCell id="user" value="User / Web UI&lt;br&gt;Natural-language request&lt;br&gt;(upload, find, update...)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="100" height="120" as="geometry"/></mxCell>
        <mxCell id="entra" value="Microsoft Entra ID&lt;br&gt;User sign-in / OIDC&lt;br&gt;App authorization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="410" width="165" height="85" as="geometry"/></mxCell>

        <mxCell id="openai" value="Azure OpenAI&lt;br&gt;Chat model" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="80" width="150" height="150" as="geometry"/></mxCell>
        <mxCell id="api" value="Application API&lt;br&gt;HTTPS ingress&lt;br&gt;Validate user identity and request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="235" width="235" height="80" as="geometry"/></mxCell>
        <mxCell id="graph" value="LangGraph supervisor&lt;br&gt;Route by task" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="blobagent" value="Blob Storage agent&lt;br&gt;Allowlisted file operations&lt;br&gt;Validate path, size, and file type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="205" height="80" as="geometry"/></mxCell>
        <mxCell id="sqlagent" value="SQL MI agent&lt;br&gt;Typed CRUD operations&lt;br&gt;No model-generated arbitrary SQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="205" height="80" as="geometry"/></mxCell>
        <mxCell id="utcpclient" value="UTCP client + protocol plugins&lt;br&gt;Load tool manuals; validate inputs;&lt;br&gt;dispatch each call via its template" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="875" y="340" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="manual" value="UTCP manual / tool catalog&lt;br&gt;Tool names, descriptions, JSON input schemas,&lt;br&gt;call templates, and auth configuration&lt;br&gt;Loaded from trusted app configuration" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="845" y="115" width="270" height="120" as="geometry"/></mxCell>

        <mxCell id="blob" value="Azure Blob Storage&lt;br&gt;Private endpoint&lt;br&gt;Blob REST / HTTPS&lt;br&gt;Container-scoped data permissions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="280" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="sqlmi" value="Azure SQL Managed Instance&lt;br&gt;Private VNet endpoint&lt;br&gt;SQL Server protocol / driver&lt;br&gt;Scoped DB user and permissions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="440" width="205" height="110" as="geometry"/></mxCell>
        <mxCell id="monitor" value="Azure Monitor / Application Insights&lt;br&gt;Distributed traces, tool name, outcome, latency&lt;br&gt;Redact prompts, tokens, and sensitive data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="625" width="390" height="80" as="geometry"/></mxCell>
        <mxCell id="note" value="UTCP is the tool description and dispatch layer, not a credential or authorization boundary. Use the app's managed identity for Azure access. Built-in UTCP plugins include HTTP, CLI, SSE, text, and MCP; SQL here requires a custom SQL Server protocol plugin. Alternative: have the HTTP plugin call an existing narrow CRUD API. Restrict destructive actions (delete) with policy and user confirmation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="280" y="570" width="515" height="135" as="geometry"/></mxCell>

        <mxCell id="e1" value="HTTPS request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;fontSize=11;" edge="1" parent="1" source="user" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Sign-in / token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="user" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Authenticated request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="entra" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="request + identity context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;fontSize=10;" edge="1" parent="1" source="api" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="prompt / tool choice / response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="graph" target="openai"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="route file task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="graph" target="blobagent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="route data task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="graph" target="sqlagent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="typed tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="blobagent" target="utcpclient"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="typed tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="sqlagent" target="utcpclient"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="manuals loaded at startup / refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;endFill=1;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="manual" target="utcpclient"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="HTTP plugin: Blob REST + Entra token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="utcpclient" target="blob"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="custom SQL plugin + driver; private network" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="utcpclient" target="sqlmi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="traces / metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="graph" target="monitor"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
