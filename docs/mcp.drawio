        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" value="Example deployment: LangGraph app and two private Streamable HTTP MCP servers hosted in a VNet-integrated app environment." vertex="1">
