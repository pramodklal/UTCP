        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=8;" value="MCP standardizes client-server tool exchange; MCP servers execute the Azure operations. Use a distinct managed identity and minimum permissions per server. Require policy / user confirmation for destructive delete operations. Use private transport, authenticated server access, and validate every tool input." vertex="1">
