        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#12304a;" value="MCP implementation - multi-agent file and SQL workflow" vertex="1">
