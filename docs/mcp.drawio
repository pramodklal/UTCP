        </mxCell>
        <mxCell id="monitor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="Azure Monitor / Application Insights&lt;br&gt;Trace user request - graph node - MCP tool - data operation&lt;br&gt;Audit outcomes; redact prompts, tokens, and sensitive data" vertex="1">
          <mxGeometry height="85" width="420" x="800" y="615" as="geometry" />
